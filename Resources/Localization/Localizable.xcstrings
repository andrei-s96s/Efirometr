          "stringUnit": {
            "state": "translated",
            "value": " Note: "
          }
        }
      }
    },
    " Это DFS‑канал: роутер может кратковременно уходить с него при обнаружении радаров.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " This is a DFS channel: the router may briefly leave it when radar is detected."
          }
        }
      }
    },
