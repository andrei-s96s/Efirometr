      }
    },
    " Если какое‑то устройство не находит вашу сеть — причина, скорее всего, в этом.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " If some device can't find your network, this is most likely why."
          }
        }
      }
    },
    " МГц": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " MHz"
